{
  "service": {
    "logLevel": "info",
    "edition": "lite",
    "webUI": { "enabled": true, "port": 4889 },
    "voiceModeEnabled": false,
    "licenseKey": "",
    "auth": { "enabled": false }
  },
  "channels": {},
  "agents": {
    "hub-lite": {
      "name": "Hub",
      "description": "Browse and install agents from the MyAIforOne registry. Ask me to find agents for any task.",
      "agentHome": "./agents/hub-lite",
      "claudeMd": "./agents/hub-lite/CLAUDE.md",
      "memoryDir": "./agents/hub-lite/memory",
      "mentionAliases": ["@hub", "@store", "@install"],
      "workspace": "~",
      "allowedTools": ["Read", "Glob", "Grep"],
      "mcps": ["myaiforone-lite"],
      "persistent": true,
      "streaming": true,
      "autoCommit": false,
      "autoCommitBranch": "",
      "routes": [],
      "avatar": "avatar-12"
    }
  },
  "mcps": {
    "myaiforone-lite": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./server/mcp-server-lite/dist/index.js"
      ],
      "env": {
        "MYAGENT_API_URL": "http://localhost:4889",
        "MYAGENT_REGISTRY_URL": "https://myaiforone.com"
      }
    },
    "myaiforone-registry": {
      "type": "http",
      "url": "https://myaiforone.com/mcp/registry"
    },
    "aigym-finance": {
      "type": "http",
      "url": "https://finance.aigym.studio/mcp"
    }
  },
  "defaultAgent": null,
  "defaultSkills": [],
  "defaultMcps": ["myaiforone-lite", "aigym-finance", "myaiforone-registry"],
  "defaultPrompts": [],
  "promptTrigger": "!"
}
