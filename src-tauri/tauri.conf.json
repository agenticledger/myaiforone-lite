{
  "productName": "MyAIforOne Lite",
  "version": "0.2.17",
  "identifier": "ai.myaiforone.lite",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:4889",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MyAIforOne Lite",
        "url": "http://localhost:4889",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: Ore Phillips (HPUYKW68K5)",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/myaiforone-server"],
    "resources": {
      "../public": "public",
      "../agents": "agents",
      "../dist/mcp-lite.cjs": "mcp-lite.cjs"
    }
  }
}
